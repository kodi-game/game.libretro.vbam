msgctxt "Addon Summary"
msgid "Nintendo - Game Boy Advance (VBA-M)"
msgstr "Nintendo - Game Boy Advance (VBA-M)"

msgctxt "Addon Description"
msgid "VBA-M is a Nintendo Game Boy and Game Boy Advance emulator based on the official VisualBoyAdvance by Forgotten and the VBA development team."
msgstr "VBA-M je emulátor Nintendo Game Boy a Game Boy Advance vycházející z oficiálního emulátoru VisualBoyAdvance od Forgottena a vývojového týmu VBA."

msgctxt "#30001"
msgid "Use Official BIOS (If Available)"
msgstr "Používat oficiální BIOS (pokud je k dispozici)"

msgctxt "#30002"
msgid "Force-Enable RTC"
msgstr "Vynutit povolení RTC"

msgctxt "#30003"
msgid "(GB) Emulated Hardware (Needs Restart)"
msgstr "(GB) Emulovaný hardware (vyžaduje restart)"

msgctxt "#30004"
msgid "(GB) Enable Colorizer Hack (Needs Restart)"
msgstr "(GB) Povolit hack kolorování (vyžaduje restart)"

msgctxt "#30005"
msgid "(GB) Color Palette"
msgstr "(GB) Barevná paleta"

msgctxt "#30006"
msgid "(GB) Show Borders"
msgstr "(GB) Zobrazit okraje"

msgctxt "#30008"
msgid "LCD Color Filter"
msgstr "Barevný filtr LCD"

msgctxt "#30009"
msgid "Interframe Blending"
msgstr "Prolínání mezi snímky"

msgctxt "#30012"
msgid "Enable Turbo Buttons"
msgstr "Povolit tlačítka Turbo"

msgctxt "#30013"
msgid "Turbo Delay (in frames)"
msgstr "Prodleva Turbo (ve snímcích)"

msgctxt "#30014"
msgid "Solar Sensor Level"
msgstr "Úroveň solárního senzoru"

msgctxt "#30015"
msgid "Sensors Deadzone (%)"
msgstr "Mrtvá zóna senzorů (%)"

msgctxt "#30016"
msgid "Sensor Sensitivity (Gyroscope) (%)"
msgstr "Citlivost senzoru (gyroskop) (%)"

msgctxt "#30017"
msgid "Sensor Sensitivity (Tilt) (%)"
msgstr "Citlivost senzoru (náklon) (%)"

msgctxt "#30018"
msgid "Swap Left/Right Analog"
msgstr "Prohodit levou/pravou analogovou páčku"

msgctxt "#30025"
msgid "Show Background Layer 1"
msgstr "Zobrazit vrstvu pozadí 1"

msgctxt "#30026"
msgid "Show Background Layer 2"
msgstr "Zobrazit vrstvu pozadí 2"

msgctxt "#30027"
msgid "Show Background Layer 3"
msgstr "Zobrazit vrstvu pozadí 3"

msgctxt "#30028"
msgid "Show Background Layer 4"
msgstr "Zobrazit vrstvu pozadí 4"

msgctxt "#30029"
msgid "Show Sprite Layer"
msgstr "Zobrazit vrstvu spritů"

msgctxt "#30030"
msgid "Show Window Layer 1"
msgstr "Zobrazit vrstvu okna 1"

msgctxt "#30031"
msgid "Show Window Layer 2"
msgstr "Zobrazit vrstvu okna 2"

msgctxt "#30032"
msgid "Show Sprite Window Layer"
msgstr "Zobrazit vrstvu spritového okna"

msgctxt "#30033"
msgid "LCD Color Filter Type"
msgstr "Typ barevného filtru LCD"

msgctxt "#30034"
msgid "LCD Color Lighten/Darken"
msgstr "Zesvětlení/ztmavení barev LCD"

msgctxt "#30035"
msgid "(GBA) Sound Interpolation"
msgstr "(GBA) Interpolace zvuku"

msgctxt "#30036"
msgid "(GBA) Sound Filtering"
msgstr "(GBA) Filtrování zvuku"

msgctxt "#30037"
msgid "(GB) Sound Effects"
msgstr "(GB) Zvukové efekty"

msgctxt "#30038"
msgid "(GB) Echo Effects"
msgstr "(GB) Efekty ozvěny"

msgctxt "#30039"
msgid "(GB) Stereo Effects"
msgstr "(GB) Stereo efekty"

msgctxt "#30040"
msgid "(GB) Surround Effects"
msgstr "(GB) Prostorové efekty"

msgctxt "#30041"
msgid "Square Channel 1 (Sweep)"
msgstr "Obdélníkový kanál 1 (frekvenční rozmítání)"

msgctxt "#30042"
msgid "Square Channel 2"
msgstr "Obdélníkový kanál 2"

msgctxt "#30043"
msgid "Wave Channel"
msgstr "Vlnový kanál"

msgctxt "#30044"
msgid "Noise Channel"
msgstr "Šumový kanál"

msgctxt "#30045"
msgid "Direct Sound A (GBA only)"
msgstr "Direct Sound A (pouze GBA)"

msgctxt "#30046"
msgid "Direct Sound B (GBA only)"
msgstr "Direct Sound B (pouze GBA)"

msgctxt "#30047"
msgid "System"
msgstr "Systém"

msgctxt "#30048"
msgid "Configure system options."
msgstr "Nastavte možnosti systému."

msgctxt "#30049"
msgid "Use official BIOS when available. Core needs to be restarted for changes to apply."
msgstr "Používá oficiální BIOS, pokud je k dispozici. K uplatnění změn je nutné restartovat jádro."

msgctxt "#30050"
msgid "Forces the internal real-time clock to be enabled regardless of rom. Usuable for rom patches that requires clock to be enabled (aka Pokemon)."
msgstr "Vynutí povolení interních hodin reálného času bez ohledu na ROM. Je užitečné pro patche ROM, které vyžadují povolené hodiny (např. Pokémon)."

msgctxt "#30051"
msgid "Sets the Game Boy hardware type to emulate. Restart core to apply."
msgstr "Nastaví emulovaný typ hardwaru Game Boy. Pro uplatnění změny restartujte jádro."

msgctxt "#30052"
msgid "Game Boy Color"
msgstr "Game Boy Color"

msgctxt "#30053"
msgid "Automatic"
msgstr "Automaticky"

msgctxt "#30054"
msgid "Super Game Boy"
msgstr "Super Game Boy"

msgctxt "#30055"
msgid "Game Boy"
msgstr "Game Boy"

msgctxt "#30056"
msgid "Game Boy Advance"
msgstr "Game Boy Advance"

msgctxt "#30057"
msgid "Super Game Boy 2"
msgstr "Super Game Boy 2"

msgctxt "#30058"
msgid "Allows Colorizer hacked GB games (e.g. DX patched games) to normally run in GBC/GBA hardware type. This also disables the use of bios file. NOT RECOMMENDED for use on non-colorized games."
msgstr "Umožní běžný chod her GB upravených hackem Colorizer (např. her s patchem DX) při zvoleném typu hardwaru GBC/GBA. Rovněž zakáže použití souboru BIOSu. NEDOPORUČUJE SE pro nekolorované hry."

msgctxt "#30059"
msgid "Video"
msgstr "Video"

msgctxt "#30060"
msgid "Configure video options."
msgstr "Nastavte možnosti videa."

msgctxt "#30061"
msgid "Set Game Boy palettes to use."
msgstr "Nastaví používané palety Game Boy."

msgctxt "#30062"
msgid "When enabled, if loaded content is SGB compatible, this will show the border from the game if available."
msgstr "Je-li tato volba povolena a načtený obsah je kompatibilní se SGB, zobrazí dostupný okraj ze hry."

msgctxt "#30063"
msgid "Darkens the onscreen colors by applying a screen filter."
msgstr "Ztmaví barvy na obrazovce použitím obrazového filtru."

msgctxt "#30064"
msgid "Screen filter type for onscreen colors."
msgstr "Typ obrazového filtru barev na obrazovce."

msgctxt "#30065"
msgid "LCD Color Filter GBA Panel"
msgstr "Barevný filtr LCD – panel GBA"

msgctxt "#30066"
msgid "LCD panel the GBA color correction emulates."
msgstr "Panel LCD, který emuluje korekce barev GBA."

msgctxt "#30067"
msgid "LCD Color Filter GBC Panel"
msgstr "Barevný filtr LCD – panel GBC"

msgctxt "#30068"
msgid "LCD panel the GBC color correction emulates."
msgstr "Panel LCD, který emuluje korekce barev GBC."

msgctxt "#30069"
msgid "Darken GBA or lighten GBC in %."
msgstr "Ztmavení GBA nebo zesvětlení GBC v %."

msgctxt "#30070"
msgid "Simulates LCD ghosting effects. 'Smart' attempts to detect screen flickering, and only performs a 50:50 mix on affected pixels, while 'Motion Blur' mimics natural LCD response times by combining multiple buffered frames. 'Smart' blending is required when playing games that aggressively exploit LCD ghosting for transparency effects (Wave Race, Chikyuu Kaihou Gun ZAS, F-Zero, the Boktai series...)."
msgstr "Simuluje efekt dosvitu LCD. 'Inteligentní' se pokouší rozpoznat blikání obrazovky a směs 50:50 provádí pouze u zasažených pixelů, zatímco 'Pohybové rozmazání' napodobuje přirozenou dobu odezvy LCD kombinováním více snímků ve vyrovnávací paměti. 'Inteligentní' prolínání je nutné při hraní her, které intenzivně využívají dosvit LCD k efektům průhlednosti (Wave Race, Chikyuu Kaihou Gun ZAS, F-Zero, série Boktai...)."

msgctxt "#30071"
msgid "Smart"
msgstr "Inteligentní"

msgctxt "#30072"
msgid "Motion Blur"
msgstr "Pohybové rozmazání"

msgctxt "#30073"
msgid "Audio"
msgstr "Zvuk"

msgctxt "#30074"
msgid "Configure audio options."
msgstr "Nastavte možnosti zvuku."

msgctxt "#30075"
msgid "Applies low-pass filtering to smooth high-frequency noise in PCM audio."
msgstr "Použije filtr dolní propusti k vyhlazení vysokofrekvenčního šumu ve zvuku PCM."

msgctxt "#30076"
msgid "Audio Driver"
msgstr "Ovladač zvuku"

msgctxt "#30077"
msgid "Selects the audio output backend. \"None\" outputs no audio and only paces emulation with a timer; it is also used automatically if the normal driver fails to initialize. Core needs to be restarted for changes to apply."
msgstr "Vybere backend zvukového výstupu. \"Žádný\" nevytváří žádný zvuk a řídí tempo emulace pouze časovačem; použije se také automaticky, pokud se nepodaří inicializovat normální ovladač. K uplatnění změn je nutné restartovat jádro."

msgctxt "#30078"
msgid "Normal"
msgstr "Normální"

msgctxt "#30079"
msgid "None (timer paced)"
msgstr "Žádný (řízeno časovačem)"

msgctxt "#30080"
msgid "Adjusts the intensity of the low-pass filter applied to audio (0 = none, 10 = maximum)."
msgstr "Upravuje intenzitu filtru dolní propusti použitého na zvuk (0 = žádná, 10 = maximální)."

msgctxt "#30081"
msgid "Enables or disabled all Game Boy sound effects."
msgstr "Povolí nebo zakáže všechny zvukové efekty Game Boy."

msgctxt "#30082"
msgid "Mix level for the reflected (echo) signal (0 = none, 10 = maximum)."
msgstr "Úroveň přimíchání odraženého signálu (ozvěny) (0 = žádná, 10 = maximální)."

msgctxt "#30083"
msgid "Adjusts stereo effect strength — higher values widen left/right placement (0 = none, 10 = maximum)"
msgstr "Upravuje intenzitu stereo efektu — vyšší hodnoty rozšiřují umístění vlevo/vpravo (0 = žádná, 10 = maximální)"

msgctxt "#30084"
msgid "Adds a surround effect, placing some channels behind the listener for a wider soundstage."
msgstr "Přidá prostorový efekt a umístí některé kanály za posluchače, čímž vytvoří širší zvukovou scénu."

msgctxt "#30085"
msgid "Input"
msgstr "Vstup"

msgctxt "#30086"
msgid "Configure input options."
msgstr "Nastavte možnosti vstupu."

msgctxt "#30087"
msgid "Enable or disable gamepad turbo buttons."
msgstr "Povolí nebo zakáže tlačítka Turbo na gamepadu."

msgctxt "#30088"
msgid "Repeat rate of turbo triggers in frames. Higher value triggers more."
msgstr "Frekvence opakování aktivace Turbo ve snímcích. Vyšší hodnota znamená častější aktivaci."

msgctxt "#30089"
msgid "Adjusts simulated solar level in Boktai games. L2/R2 buttons can also be used to quickly change levels."
msgstr "Upravuje simulovanou úroveň slunečního světla ve hrách Boktai. K rychlé změně úrovně lze použít také tlačítka L2/R2."

msgctxt "#30090"
msgid "Set deadzone (in percent) of analog sticks."
msgstr "Nastaví mrtvou zónu analogových páček (v procentech)."

msgctxt "#30091"
msgid "Default bind is left analog. Used to adjust sensitivity level for gyro-enabled games."
msgstr "Výchozí přiřazení je levá analogová páčka. Používá se k úpravě citlivosti ve hrách s gyroskopem."

msgctxt "#30092"
msgid "Default bind is right analog. Used to adjust sensitivity level for gyro-enabled games."
msgstr "Výchozí přiřazení je pravá analogová páčka. Používá se k úpravě citlivosti ve hrách s gyroskopem."

msgctxt "#30093"
msgid "Swaps left and right analog stick function for gyro and tilt."
msgstr "Prohodí funkce levé a pravé analogové páčky pro gyroskop a náklon."

msgctxt "#30094"
msgid "Advanced options"
msgstr "Pokročilé možnosti"

msgctxt "#30095"
msgid "Configure advanced options which can enable or disable sound channels and graphics layers."
msgstr "Umožňuje nastavit pokročilé možnosti, kterými lze povolit nebo zakázat zvukové kanály a grafické vrstvy."

msgctxt "#30096"
msgid "Enables or disables square wave channel 1 with frequency sweep (tone + sweep)."
msgstr "Povolí nebo zakáže kanál obdélníkového průběhu 1 s frekvenčním rozmítáním (tón + rozmítání)."

msgctxt "#30097"
msgid "Enables or disables square wave channel 2 (tone only)."
msgstr "Povolí nebo zakáže kanál obdélníkového průběhu 2 (pouze tón)."

msgctxt "#30098"
msgid "Enables or disables programmable waveform channel (custom samples)."
msgstr "Povolí nebo zakáže kanál programovatelného průběhu (vlastní samply)."

msgctxt "#30099"
msgid "Enables or disables noise generator channel (percussion / effects)."
msgstr "Povolí nebo zakáže kanál generátoru šumu (bicí / efekty)."

msgctxt "#30100"
msgid "Enables or disables Direct Sound channel A (PCM / DMA audio stream)."
msgstr "Povolí nebo zakáže kanál Direct Sound A (zvukový stream PCM / DMA)."

msgctxt "#30101"
msgid "Enables or disables Direct Sound channel B (PCM / DMA audio stream)."
msgstr "Povolí nebo zakáže kanál Direct Sound B (zvukový stream PCM / DMA)."

msgctxt "#30102"
msgid "Shows or hides background layer 1."
msgstr "Zobrazí nebo skryje vrstvu pozadí 1."

msgctxt "#30103"
msgid "Shows or hides background layer 2."
msgstr "Zobrazí nebo skryje vrstvu pozadí 2."

msgctxt "#30104"
msgid "Shows or hides background layer 3."
msgstr "Zobrazí nebo skryje vrstvu pozadí 3."

msgctxt "#30105"
msgid "Shows or hides background layer 4."
msgstr "Zobrazí nebo skryje vrstvu pozadí 4."

msgctxt "#30106"
msgid "Shows or hides sprite layer."
msgstr "Zobrazí nebo skryje vrstvu spritů."

msgctxt "#30107"
msgid "Shows or hides window layer 1."
msgstr "Zobrazí nebo skryje vrstvu okna 1."

msgctxt "#30108"
msgid "Shows or hides window layer 2."
msgstr "Zobrazí nebo skryje vrstvu okna 2."

msgctxt "#30109"
msgid "Shows or hides sprite window layer."
msgstr "Zobrazí nebo skryje vrstvu spritového okna."
