msgctxt "Addon Summary"
msgid "Nintendo - Game Boy Advance (VBA-M)"
msgstr "Nintendo — Game Boy Advance (VBA-M)"

msgctxt "Addon Description"
msgid "VBA-M is a Nintendo Game Boy and Game Boy Advance emulator based on the official VisualBoyAdvance by Forgotten and the VBA development team."
msgstr "VBA-M — это эмулятор Nintendo Game Boy и Game Boy Advance, основанный на официальном VisualBoyAdvance от Forgotten и команды разработчиков VBA."

msgctxt "#30001"
msgid "Use Official BIOS (If Available)"
msgstr "Использовать официальный BIOS (если доступен)"

msgctxt "#30002"
msgid "Force-Enable RTC"
msgstr "Принудительно включить RTC"

msgctxt "#30003"
msgid "(GB) Emulated Hardware (Needs Restart)"
msgstr "(GB) Эмулируемое оборудование (требуется перезапуск)"

msgctxt "#30004"
msgid "(GB) Enable Colorizer Hack (Needs Restart)"
msgstr "(GB) Включить хак раскрашивания (требуется перезапуск)"

msgctxt "#30005"
msgid "(GB) Color Palette"
msgstr "(GB) Цветовая палитра"

msgctxt "#30006"
msgid "(GB) Show Borders"
msgstr "(GB) Показывать границы"

msgctxt "#30008"
msgid "LCD Color Filter"
msgstr "Цветовой фильтр ЖК-экрана"

msgctxt "#30009"
msgid "Interframe Blending"
msgstr "Смешивание межкадров"

msgctxt "#30012"
msgid "Enable Turbo Buttons"
msgstr "Включить турбо-кнопки"

msgctxt "#30013"
msgid "Turbo Delay (in frames)"
msgstr "Задержка турбо (в кадрах)"

msgctxt "#30014"
msgid "Solar Sensor Level"
msgstr "Уровень солнечного датчика"

msgctxt "#30015"
msgid "Sensors Deadzone (%)"
msgstr "Мёртвая зона датчиков (%)"

msgctxt "#30016"
msgid "Sensor Sensitivity (Gyroscope) (%)"
msgstr "Чувствительность датчика (гироскоп) (%)"

msgctxt "#30017"
msgid "Sensor Sensitivity (Tilt) (%)"
msgstr "Чувствительность датчика (наклон) (%)"

msgctxt "#30018"
msgid "Swap Left/Right Analog"
msgstr "Поменять местами левый/правый аналог"

msgctxt "#30025"
msgid "Show Background Layer 1"
msgstr "Показывать фоновый слой 1"

msgctxt "#30026"
msgid "Show Background Layer 2"
msgstr "Показывать фоновый слой 2"

msgctxt "#30027"
msgid "Show Background Layer 3"
msgstr "Показывать фоновый слой 3"

msgctxt "#30028"
msgid "Show Background Layer 4"
msgstr "Показывать фоновый слой 4"

msgctxt "#30029"
msgid "Show Sprite Layer"
msgstr "Показывать слой спрайтов"

msgctxt "#30030"
msgid "Show Window Layer 1"
msgstr "Показывать оконный слой 1"

msgctxt "#30031"
msgid "Show Window Layer 2"
msgstr "Показывать оконный слой 2"

msgctxt "#30032"
msgid "Show Sprite Window Layer"
msgstr "Показывать оконный слой спрайтов"

msgctxt "#30033"
msgid "LCD Color Filter Type"
msgstr "Тип цветового фильтра ЖК-экрана"

msgctxt "#30034"
msgid "LCD Color Lighten/Darken"
msgstr "Осветление/затемнение цвета ЖК-экрана"

msgctxt "#30035"
msgid "(GBA) Sound Interpolation"
msgstr "(GBA) Интерполяция звука"

msgctxt "#30036"
msgid "(GBA) Sound Filtering"
msgstr "(GBA) Фильтрация звука"

msgctxt "#30037"
msgid "(GB) Sound Effects"
msgstr "(GB) Звуковые эффекты"

msgctxt "#30038"
msgid "(GB) Echo Effects"
msgstr "(GB) Эхо-эффекты"

msgctxt "#30039"
msgid "(GB) Stereo Effects"
msgstr "(GB) Стереоэффекты"

msgctxt "#30040"
msgid "(GB) Surround Effects"
msgstr "(GB) Эффекты объёмного звучания"

msgctxt "#30041"
msgid "Square Channel 1 (Sweep)"
msgstr "Прямоугольный канал 1 (Sweep)"

msgctxt "#30042"
msgid "Square Channel 2"
msgstr "Прямоугольный канал 2"

msgctxt "#30043"
msgid "Wave Channel"
msgstr "Волновой канал"

msgctxt "#30044"
msgid "Noise Channel"
msgstr "Шумовой канал"

msgctxt "#30045"
msgid "Direct Sound A (GBA only)"
msgstr "Direct Sound A (только GBA)"

msgctxt "#30046"
msgid "Direct Sound B (GBA only)"
msgstr "Direct Sound B (только GBA)"

msgctxt "#30047"
msgid "System"
msgstr "Система"

msgctxt "#30048"
msgid "Configure system options."
msgstr "Настройка параметров системы."

msgctxt "#30049"
msgid "Use official BIOS when available. Core needs to be restarted for changes to apply."
msgstr "Использовать официальный BIOS, когда он доступен. Для применения изменений требуется перезапуск ядра."

msgctxt "#30050"
msgid "Forces the internal real-time clock to be enabled regardless of rom. Usuable for rom patches that requires clock to be enabled (aka Pokemon)."
msgstr "Принудительно включает внутренние часы реального времени независимо от ROM. Может использоваться для патчей ROM, требующих включённых часов (например, Pokemon)."

msgctxt "#30051"
msgid "Sets the Game Boy hardware type to emulate. Restart core to apply."
msgstr "Задаёт тип оборудования Game Boy для эмуляции. Перезапустите ядро для применения."

msgctxt "#30052"
msgid "Game Boy Color"
msgstr "Game Boy Color"

msgctxt "#30053"
msgid "Automatic"
msgstr "Автоматически"

msgctxt "#30054"
msgid "Super Game Boy"
msgstr "Super Game Boy"

msgctxt "#30055"
msgid "Game Boy"
msgstr "Game Boy"

msgctxt "#30056"
msgid "Game Boy Advance"
msgstr "Game Boy Advance"

msgctxt "#30057"
msgid "Super Game Boy 2"
msgstr "Super Game Boy 2"

msgctxt "#30058"
msgid "Allows Colorizer hacked GB games (e.g. DX patched games) to normally run in GBC/GBA hardware type. This also disables the use of bios file. NOT RECOMMENDED for use on non-colorized games."
msgstr "Позволяет взломанным играм GB с Colorizer (например, играм с патчем DX) нормально работать в типе оборудования GBC/GBA. Это также отключает использование файла BIOS. НЕ РЕКОМЕНДУЕТСЯ для нераскрашенных игр."

msgctxt "#30059"
msgid "Video"
msgstr "Видео"

msgctxt "#30060"
msgid "Configure video options."
msgstr "Настройка параметров видео."

msgctxt "#30061"
msgid "Set Game Boy palettes to use."
msgstr "Задать используемые палитры Game Boy."

msgctxt "#30062"
msgid "When enabled, if loaded content is SGB compatible, this will show the border from the game if available."
msgstr "Когда включено, если загруженное содержимое совместимо с SGB, это покажет рамку из игры, если она доступна."

msgctxt "#30063"
msgid "Darkens the onscreen colors by applying a screen filter."
msgstr "Затемняет экранные цвета, применяя экранный фильтр."

msgctxt "#30064"
msgid "Screen filter type for onscreen colors."
msgstr "Тип экранного фильтра для экранных цветов."

msgctxt "#30065"
msgid "LCD Color Filter GBA Panel"
msgstr "Цветовой фильтр ЖК-панели GBA"

msgctxt "#30066"
msgid "LCD panel the GBA color correction emulates."
msgstr "ЖК-панель, которую имитирует цветокоррекция GBA."

msgctxt "#30067"
msgid "LCD Color Filter GBC Panel"
msgstr "Цветовой фильтр ЖК-панели GBC"

msgctxt "#30068"
msgid "LCD panel the GBC color correction emulates."
msgstr "ЖК-панель, которую имитирует цветокоррекция GBC."

msgctxt "#30069"
msgid "Darken GBA or lighten GBC in %."
msgstr "Затемнить GBA или осветлить GBC в %."

msgctxt "#30070"
msgid "Simulates LCD ghosting effects. 'Smart' attempts to detect screen flickering, and only performs a 50:50 mix on affected pixels, while 'Motion Blur' mimics natural LCD response times by combining multiple buffered frames. 'Smart' blending is required when playing games that aggressively exploit LCD ghosting for transparency effects (Wave Race, Chikyuu Kaihou Gun ZAS, F-Zero, the Boktai series...)."
msgstr "Имитирует эффекты послесвечения ЖК-экрана. «Умный» пытается обнаружить мерцание экрана и выполняет смешивание 50:50 только на затронутых пикселях, тогда как «Размытие движения» имитирует естественное время отклика ЖК-экрана путём объединения нескольких буферизованных кадров. «Умное» смешивание требуется при игре в игры, которые агрессивно используют послесвечение ЖК-экрана для эффектов прозрачности (Wave Race, Chikyuu Kaihou Gun ZAS, F-Zero, серия Boktai...)."

msgctxt "#30071"
msgid "Smart"
msgstr "Умный"

msgctxt "#30072"
msgid "Motion Blur"
msgstr "Размытие движения"

msgctxt "#30073"
msgid "Audio"
msgstr "Аудио"

msgctxt "#30074"
msgid "Configure audio options."
msgstr "Настройка параметров аудио."

msgctxt "#30075"
msgid "Applies low-pass filtering to smooth high-frequency noise in PCM audio."
msgstr "Применяет фильтрацию нижних частот для сглаживания высокочастотного шума в аудио PCM."

msgctxt "#30076"
msgid "Audio Driver"
msgstr "Звуковой драйвер"

msgctxt "#30077"
msgid "Selects the audio output backend. \"None\" outputs no audio and only paces emulation with a timer; it is also used automatically if the normal driver fails to initialize. Core needs to be restarted for changes to apply."
msgstr "Выбирает бэкенд звукового вывода. «Нет» не выводит звук и только синхронизирует эмуляцию таймером; также используется автоматически, если обычный драйвер не может инициализироваться. Для применения изменений требуется перезапуск ядра."

msgctxt "#30078"
msgid "Normal"
msgstr "Обычный"

msgctxt "#30079"
msgid "None (timer paced)"
msgstr "Нет (синхронизация таймером)"

msgctxt "#30080"
msgid "Adjusts the intensity of the low-pass filter applied to audio (0 = none, 10 = maximum)."
msgstr "Настраивает интенсивность фильтра нижних частот, применяемого к аудио (0 = нет, 10 = максимум)."

msgctxt "#30081"
msgid "Enables or disabled all Game Boy sound effects."
msgstr "Включает или отключает все звуковые эффекты Game Boy."

msgctxt "#30082"
msgid "Mix level for the reflected (echo) signal (0 = none, 10 = maximum)."
msgstr "Уровень микширования отражённого (эхо) сигнала (0 = нет, 10 = максимум)."

msgctxt "#30083"
msgid "Adjusts stereo effect strength — higher values widen left/right placement (0 = none, 10 = maximum)"
msgstr "Настраивает силу стереоэффекта — более высокие значения расширяют расположение влево/вправо (0 = нет, 10 = максимум)"

msgctxt "#30084"
msgid "Adds a surround effect, placing some channels behind the listener for a wider soundstage."
msgstr "Добавляет эффект объёмного звучания, размещая некоторые каналы позади слушателя для более широкой звуковой сцены."

msgctxt "#30085"
msgid "Input"
msgstr "Ввод"

msgctxt "#30086"
msgid "Configure input options."
msgstr "Настройка параметров ввода."

msgctxt "#30087"
msgid "Enable or disable gamepad turbo buttons."
msgstr "Включить или отключить кнопки турбо геймпада."

msgctxt "#30088"
msgid "Repeat rate of turbo triggers in frames. Higher value triggers more."
msgstr "Частота повторения турбо-срабатываний в кадрах. Более высокое значение срабатывает чаще."

msgctxt "#30089"
msgid "Adjusts simulated solar level in Boktai games. L2/R2 buttons can also be used to quickly change levels."
msgstr "Настраивает имитируемый уровень солнечного света в играх Boktai. Кнопки L2/R2 также можно использовать для быстрого изменения уровней."

msgctxt "#30090"
msgid "Set deadzone (in percent) of analog sticks."
msgstr "Задать мёртвую зону (в процентах) аналоговых стиков."

msgctxt "#30091"
msgid "Default bind is left analog. Used to adjust sensitivity level for gyro-enabled games."
msgstr "Привязка по умолчанию — левый аналоговый. Используется для настройки уровня чувствительности в играх с поддержкой гироскопа."

msgctxt "#30092"
msgid "Default bind is right analog. Used to adjust sensitivity level for gyro-enabled games."
msgstr "Привязка по умолчанию — правый аналоговый. Используется для настройки уровня чувствительности в играх с поддержкой гироскопа."

msgctxt "#30093"
msgid "Swaps left and right analog stick function for gyro and tilt."
msgstr "Меняет местами функции левого и правого аналоговых стиков для гироскопа и наклона."

msgctxt "#30094"
msgid "Advanced options"
msgstr "Дополнительные параметры"

msgctxt "#30095"
msgid "Configure advanced options which can enable or disable sound channels and graphics layers."
msgstr "Настройка дополнительных параметров, позволяющих включать или отключать звуковые каналы и графические слои."

msgctxt "#30096"
msgid "Enables or disables square wave channel 1 with frequency sweep (tone + sweep)."
msgstr "Включает или отключает канал прямоугольной волны 1 с частотной развёрткой (тон + развёртка)."

msgctxt "#30097"
msgid "Enables or disables square wave channel 2 (tone only)."
msgstr "Включает или отключает канал прямоугольной волны 2 (только тон)."

msgctxt "#30098"
msgid "Enables or disables programmable waveform channel (custom samples)."
msgstr "Включает или отключает канал программируемой формы волны (пользовательские сэмплы)."

msgctxt "#30099"
msgid "Enables or disables noise generator channel (percussion / effects)."
msgstr "Включает или отключает канал генератора шума (перкуссия / эффекты)."

msgctxt "#30100"
msgid "Enables or disables Direct Sound channel A (PCM / DMA audio stream)."
msgstr "Включает или отключает канал Direct Sound A (аудиопоток PCM / DMA)."

msgctxt "#30101"
msgid "Enables or disables Direct Sound channel B (PCM / DMA audio stream)."
msgstr "Включает или отключает канал Direct Sound B (аудиопоток PCM / DMA)."

msgctxt "#30102"
msgid "Shows or hides background layer 1."
msgstr "Показывает или скрывает фоновый слой 1."

msgctxt "#30103"
msgid "Shows or hides background layer 2."
msgstr "Показывает или скрывает фоновый слой 2."

msgctxt "#30104"
msgid "Shows or hides background layer 3."
msgstr "Показывает или скрывает фоновый слой 3."

msgctxt "#30105"
msgid "Shows or hides background layer 4."
msgstr "Показывает или скрывает фоновый слой 4."

msgctxt "#30106"
msgid "Shows or hides sprite layer."
msgstr "Показывает или скрывает слой спрайтов."

msgctxt "#30107"
msgid "Shows or hides window layer 1."
msgstr "Показывает или скрывает слой окна 1."

msgctxt "#30108"
msgid "Shows or hides window layer 2."
msgstr "Показывает или скрывает слой окна 2."

msgctxt "#30109"
msgid "Shows or hides sprite window layer."
msgstr "Показывает или скрывает слой окна спрайтов."

#~ msgctxt "#30000"
#~ msgid "Settings"
#~ msgstr "Настройки"
